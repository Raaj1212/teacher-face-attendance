      const saved = parseFloat(localStorage.getItem("bps_gps_radius_meters"));
      if (!isNaN(saved) && saved >= 5 && saved <= 5000) {
        return saved;
      }
      return DEFAULT_CAMPUS_METERS;
    }

    function saveGpsRadius() {
      const input = document.getElementById("gps-radius-input");
      const statusEl = document.getElementById("gps-radius-status");
      const val = parseFloat(input.value);
      if (isNaN(val) || val < 5 || val > 5000) {
        statusEl.className = "text-[11px] text-red-400 mt-1.5";
