    function closeTempPinModal() {
      const modal = document.getElementById("temp-pin-modal");
      if (modal) modal.classList.add("hidden");
    }

    function requestNewTempPinToSheet() {
      const msgEl = document.getElementById("temp-pin-modal-msg");
      const expEl = document.getElementById("admin-temp-pin-expiry");
      const durationMs = getConfiguredTempDurationMs();
      if (msgEl) {
        msgEl.className = "text-[11px] text-center text-sky-300 mt-1.5";
        msgEl.innerText = "Generating & saving PIN in Sheet...";
      }
      if (expEl) expEl.innerText = "Saving to Sheet...";

      fetch(WEB_APP_URL, {
        method: "POST",
        keepalive: true,
        body: JSON.stringify({
          action: "regenerateTempPin"
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data && data.status === "SUCCESS") {
          syncedTempPin = String(data.pin || "");
          syncedTempPinExpires = parseInt(data.expiresAt || "0", 10) || (Date.now() + durationMs);
          updateAdminTempPinDisplay();
          if (msgEl) {
            msgEl.className = "text-[11px] text-center text-emerald-400 mt-1.5 font-semibold";
            msgEl.innerText = "New PIN saved in Sheet! Sync Sheet on your phone to view.";
          }
          setStatus("New Temp PIN saved to Google Sheet.", "success", 2500, true);
        } else {
          if (msgEl) {
            msgEl.className = "text-[11px] text-center text-red-400 mt-1.5";
            msgEl.innerText = (data && data.message) || "Failed to generate PIN";
          }
        }
      })
      .catch(err => {
        if (msgEl) {
          msgEl.className = "text-[11px] text-center text-red-400 mt-1.5";
          msgEl.innerText = "Network error: " + err.message;
        }
      });
    }

    function submitTempUniversalPin() {
      const inp = document.getElementById("temp-pin-input");
      const msgEl = document.getElementById("temp-pin-modal-msg");
      const cleanPin = inp ? inp.value.trim() : "";

      if (!/^\d{4}$/.test(cleanPin)) {
        if (msgEl) {
          msgEl.className = "text-[11px] text-center text-red-400 mt-1.5";
          msgEl.innerText = "कृपया सही 4-डिजिट नंबर पिन डालें।";
        }
        return;
      }

      if (msgEl) {
        msgEl.className = "text-[11px] text-center text-sky-300 mt-1.5";
        msgEl.innerText = "Verifying PIN...";
      }

      fetch(WEB_APP_URL, {
        method: "POST",
        keepalive: true,
        body: JSON.stringify({
          action: "verifyTempPin",
          pin: cleanPin,
          deviceToken: getDeviceToken(),
          userAgent: navigator.userAgent || ""
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data && data.status === "SUCCESS") {
          const durationMs = getConfiguredTempDurationMs();
          const expiresAt = Date.now() + durationMs;
          localStorage.setItem("bps_temp_universal_until", String(expiresAt));
          if (data.nextPin) {
            syncedTempPin = String(data.nextPin);
            syncedTempPinExpires = parseInt(data.nextExpiresAt || "0", 10) || expiresAt;
            updateAdminTempPinDisplay();
          }
          updateModeLabels();
          updateCountdownClock();
          closeTempPinModal();
          const durLabel = formatDurationShort();
          setStatus(`Temp Universal Active for ${durLabel} (No GPS)!`, "success", 4000, true);
          alert(`Success! यह डिवाइस अब ${durLabel} के लिए Universal Device (बिना GPS सीमा) बन गया है।`);
        } else {
          if (msgEl) {
            msgEl.className = "text-[11px] text-center text-red-400 mt-1.5";
            msgEl.innerText = (data && data.message) || "Invalid or already used PIN!";
          }
        }
      })
      .catch(err => {
        if (msgEl) {
          msgEl.className = "text-[11px] text-center text-red-400 mt-1.5";
          msgEl.innerText = "Network error: " + err.message;
        }
      });
    }

