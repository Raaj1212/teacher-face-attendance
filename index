      }
      localStorage.setItem("bps_gps_radius_meters", String(val));
      updateModeLabels();
      statusEl.className = "text-[11px] text-emerald-300 mt-1.5";
      statusEl.innerText = `GPS सीमा ${val} मीटर पर सेव हो गई!`;
    }

    function getDeviceToken() {
      let token = localStorage.getItem("bps_device_token");
      if (!token) {
        token = "dev_" + Math.random().toString(36).substring(2) + Date.now().toString(36);
        localStorage.setItem("bps_device_token", token);
      }
      return token;
    }

    function getClientMode() {
      if (isTempUniversalActive()) return "universal";
      return localStorage.getItem("bps_device_mode") || "personal";
    }

    function getUniversalDevicesMap() {
      try {
        const raw = localStorage.getItem("bps_universal_devices_map");
        const parsed = raw ? JSON.parse(raw) : {};
        return (parsed && typeof parsed === "object") ? parsed : {};
      } catch (e) {
        return {};
      }
    }

    function saveUniversalDevicesMap(map) {
      localStorage.setItem("bps_universal_devices_map", JSON.stringify(map));
    }

    function upsertUniversalDeviceInLocal(token, label, requireGps) {
      const map = getUniversalDevicesMap();
      const existing = map[token] || {};
      map[token] = {
        token: token,
        label: (label && label.trim()) ? label.trim() : (existing.label || (token === getDeviceToken() ? "This Device" : "Universal Device")),
        requireGps: (typeof requireGps === "boolean") ? requireGps : (typeof existing.requireGps === "boolean" ? existing.requireGps : true),
        updatedAt: Date.now()
      };
      saveUniversalDevicesMap(map);
    }

    function isCurrentDeviceGpsBypassed() {
      if (isTempUniversalActive()) return true;
      if (getClientMode() !== "universal") return false;
      const token = getDeviceToken();
      const map = getUniversalDevicesMap();
      if (!map[token]) return false;
      return map[token].requireGps === false;
    }

    function renderUniversalDevicesList() {
      const container = document.getElementById("universal-devices-list");
      if (!container) return;

      const map = getUniversalDevicesMap();
      const currentToken = getDeviceToken();

      if ((localStorage.getItem("bps_device_mode") === "universal") && !map[currentToken]) {
        upsertUniversalDeviceInLocal(currentToken, "This Device", true);
      }

      const updatedMap = getUniversalDevicesMap();
      const tokens = Object.keys(updatedMap);

      if (tokens.length === 0) {
        container.innerHTML = '<p class="text-xs text-slate-400">No universal devices bound yet.</p>';
        return;
      }

      let html = "";
      tokens.forEach(tok => {
        const dev = updatedMap[tok];
        const isCurrent = tok === currentToken;
        const checkedAttr = dev.requireGps !== false ? "checked" : "";
        const gpsBadge = dev.requireGps !== false
          ? '<span class="text-[10px] text-amber-300">GPS Boundary Required</span>'
          : '<span class="text-[10px] text-emerald-300">GPS Bypassed (Any Location)</span>';

        html += `
          <div class="flex items-center justify-between bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 gap-2">
            <div class="min-w-0">
              <div class="text-xs font-semibold text-white truncate">
                ${escapeHtml(dev.label || "Universal Device")} ${isCurrent ? '<span class="text-[10px] text-sky-400">(Current)</span>' : ""}
              </div>
              <div class="text-[10px] text-slate-400 truncate">${escapeHtml(tok)}</div>
              <div>${gpsBadge}</div>
            </div>
            <label class="flex items-center gap-1.5 text-xs text-slate-200 cursor-pointer shrink-0 select-none">
              <input
                type="checkbox"
                ${checkedAttr}
                onchange="toggleUniversalDeviceGps('${escapeAttr(tok)}', this.checked)"
                class="w-4 h-4 accent-emerald-500 rounded"
              >
              <span>GPS</span>
            </label>
          </div>
        `;
      });

      container.innerHTML = html;
    }

    function toggleUniversalDeviceGps(token, requireGps) {
      const map = getUniversalDevicesMap();
      const existing = map[token] || { token: token, label: "Universal Device" };
      existing.requireGps = Boolean(requireGps);
      existing.updatedAt = Date.now();
      map[token] = existing;
      saveUniversalDevicesMap(map);
      updateModeLabels();
      renderUniversalDevicesList();

