    function calculateDistanceMeters(lat1, lon1, lat2, lon2) {
      const R = 6371e3;
      const φ1 = lat1 * Math.PI / 180;
      const φ2 = lat2 * Math.PI / 180;
      const Δφ = (lat2 - lat1) * Math.PI / 180;
      const Δλ = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(Δφ / 2) * Math.sin(Δφ / 2) +
                Math.cos(φ1) * Math.cos(φ2) * Math.sin(Δλ / 2) * Math.sin(Δλ / 2);
      return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
    }

    function ensureFaceApiScript() {
      return new Promise((resolve, reject) => {
        if (typeof faceapi !== "undefined") {
          resolve();
          return;
        }
        const fallbackUrls = [
          "https://unpkg.com/@vladmandic/face-api@1.7.13/dist/face-api.js",
          "https://cdn.jsdelivr.net/npm/@vladmandic/face-api/dist/face-api.min.js",
          "https://unpkg.com/@vladmandic/face-api/dist/face-api.min.js"
        ];
        let idx = 0;

        function tryNext() {
          if (typeof faceapi !== "undefined") {
            resolve();
            return;
          }
          if (idx >= fallbackUrls.length) {
            reject(new Error("faceapi script blocked or failed to load from all CDNs"));
            return;
          }
          const s = document.createElement("script");
          s.src = fallbackUrls[idx++];
          s.async = false;
          s.onload = () => {
            if (typeof faceapi !== "undefined") resolve();
            else tryNext();
          };
          s.onerror = () => tryNext();
          document.head.appendChild(s);
        }

        const primary = document.getElementById("faceapi-script");
        if (primary) {
          primary.addEventListener("load", () => {
            if (typeof faceapi !== "undefined") resolve();
            else tryNext();
          });
          primary.addEventListener("error", tryNext);
          setTimeout(() => {
            if (typeof faceapi === "undefined") tryNext();
          }, 3000);
        } else {
          tryNext();
        }
      });
    }

    async function loadModels() {
      updateModeLabels();
      startBackgroundGpsWatcher();
      try {
        await ensureFaceApiScript();

        if (typeof faceapi !== "undefined" && faceapi.tf) {
          try {
            await faceapi.tf.setBackend("webgl");
          } catch (backendErr) {
            await faceapi.tf.setBackend("cpu");
          }
          await faceapi.tf.ready();
        }

        const nets = faceapi.nets || {};
        const detectorNet = nets.tinyFaceDetector;
        const landmarkNet = nets.faceLandmark68Net || nets.faceLandmarkNet;
        const recognitionNet = nets.faceRecognitionNet;

        if (!detectorNet || !landmarkNet || !recognitionNet) {
          throw new Error("Required face-api network modules are unavailable");
        }

        const modelUrls = [
          "https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.13/model/",
          "https://unpkg.com/@vladmandic/face-api@1.7.13/model/"
        ];
        let loaded = false;
        let lastErr = null;
        for (const modelUrl of modelUrls) {
          try {
            await detectorNet.loadFromUri(modelUrl);
            await landmarkNet.loadFromUri(modelUrl);
            await recognitionNet.loadFromUri(modelUrl);
            loaded = true;
            break;
          } catch (e) {
            lastErr = e;
          }
        }
        if (!loaded) throw lastErr || new Error("Failed to load face models");

        isModelLoaded = true;
        loadingBox.innerText = "Full-Frame Portrait Face Kiosk Ready";
        loadingBox.className = "text-emerald-400 font-medium text-xs mb-2 text-center";
        startCamera();
        fetchConfigAndTeachers(false);
      } catch (err) {
        loadingBox.innerText = "Model load error: " + err.message;
        loadingBox.className = "text-red-400 font-medium text-xs mb-2 text-center";
      }
    }

    async function processTurboFrame(now) {
      if (
        !isModelLoaded ||
        isScanBusy ||
        preparedTeachers.length === 0 ||
        video.readyState < 2 ||
        !document.getElementById("admin-modal").classList.contains("hidden") ||
        !document.getElementById("temp-pin-modal").classList.contains("hidden")
      ) {
        return;
      }

      if (now - lastScanTimestamp < FRAME_MIN_GAP_MS) {
        return;
      }

      isScanBusy = true;
      lastScanTimestamp = now;

      try {
        turboCtx.drawImage(video, 0, 0, turboCanvas.width, turboCanvas.height);

        const detection = await faceapi
          .detectSingleFace(turboCanvas, TURBO_DETECTOR_OPTIONS())
          .withFaceLandmarks()
          .withFaceDescriptor();

        if (!detection) {
          return;
        }

        let matchedTeacher = null;
        let bestDistance = MATCH_THRESHOLD;
        let strongMatchFound = false;

        for (let i = 0; i < preparedTeachers.length; i++) {
          const t = preparedTeachers[i];
          for (let j = 0; j < t.descriptors.length; j++) {
            const dist = faceapi.euclideanDistance(detection.descriptor, t.descriptors[j]);
            if (dist < bestDistance) {
              bestDistance = dist;
              matchedTeacher = t;
              if (dist <= STRONG_MATCH_BREAK) {
                strongMatchFound = true;
                break;
              }
            }
          }
          if (strongMatchFound) break;
        }

        if (matchedTeacher) {
          verifyLocationAndPunch(matchedTeacher);
        } else {
          setStatus("Unrecognized face — rescanning...", "error", 2000, true);
        }
      } catch (e) {
      } finally {
        isScanBusy = false;
      }
    }

    function startTurboScanLoop() {
      if (scanRafActive) return;
      scanRafActive = true;

      function loop(now) {
        processTurboFrame(now);
        requestAnimationFrame(loop);
      }

      requestAnimationFrame(loop);
    }

    video.addEventListener("play", () => {
      if (typeof faceapi === "undefined") return;
      enforceVideoMirror(video, useFrontCamera);
      const canvas = document.getElementById("overlay");
      faceapi.matchDimensions(canvas, {
        width: video.videoWidth || 360,
        height: video.videoHeight || 480
      });
      startTurboScanLoop();
    });

    function getFastCoordinates() {
      return new Promise((resolve, reject) => {
        if (cachedCoords && (Date.now() - cachedCoordsTime < 5000)) {
          resolve(cachedCoords);
          return;
        }
        if (!navigator.geolocation) {
          reject(new Error("GPS unsupported"));
          return;
        }
        navigator.geolocation.getCurrentPosition(
          pos => {
            cachedCoords = pos.coords;
            cachedCoordsTime = Date.now();
            resolve(pos.coords);
          },
          err => reject(err),
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
      });
    }

    async function verifyLocationAndPunch(teacher) {
      const now = Date.now();
      const delayMs = getPunchDelayMs();

      if (isPunchInFlight[teacher.deviceId]) {
        return;
      }

      if (delayMs > 0 && lastPunchTime[teacher.deviceId] && (now - lastPunchTime[teacher.deviceId] < delayMs)) {
        const waitSec = Math.ceil((delayMs - (now - lastPunchTime[teacher.deviceId])) / 1000);
        setStatus(`<b>${escapeHtml(teacher.name)}</b> — Please wait ${waitSec}s before next punch`, "warn", 1500, true);
        return;
      }

      const isUniversalClient = getClientMode() === "universal";
      const maxMeters = getMaxCampusMeters();

      if (attendanceMode === "Only_Universal" && !isUniversalClient) {
        setStatus("Blocked: Only Universal Kiosk devices allowed. Rescanning...", "error", 2500, true);
        return;
      }

      if (isUniversalClient && isCurrentDeviceGpsBypassed()) {
        sendAttendanceRealTime(teacher);
        return;
      }

      try {
        const coords = await getFastCoordinates();
        const dist = calculateDistanceMeters(
          schoolLat,
          schoolLng,
          coords.latitude,
          coords.longitude
        );
        if (dist <= maxMeters) {
          sendAttendanceRealTime(teacher);
        } else {
          const accText = typeof coords.accuracy === "number" ? ` | GPS Acc: ±${Math.round(coords.accuracy)}m` : "";
          setStatus(
            `Outside boundary (${Math.round(dist)}m${accText}). Rescanning...`,
            "error",
            2500,
            true
          );
        }
      } catch (e) {
        setStatus("Enable GPS / Location — rescanning...", "warn", 2500, true);
      }
    }

    function getFirstName(fullName) {
      if (!fullName) return "";
      const cleaned = String(fullName).trim();
      if (!cleaned) return "";
      return cleaned.split(/\s+/)[0];
    }

    function speakFirstNameOnly(fullName) {
      if (!("speechSynthesis" in window)) return;
      const firstName = getFirstName(fullName);
      if (!firstName) return;
      try {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(firstName);
        utter.rate = 1.25;
        window.speechSynthesis.speak(utter);
      } catch (e) {}
    }

    function sendAttendanceRealTime(teacher) {
      lastPunchTime[teacher.deviceId] = Date.now();
      isPunchInFlight[teacher.deviceId] = true;

      const localTime = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      setStatus(`<b>${escapeHtml(teacher.name)}</b> — Marked at ${escapeHtml(localTime)}`, "success", STATUS_RESET_AFTER_MS, true);
      speakFirstNameOnly(teacher.name);

      fetch(WEB_APP_URL, {
        method: "POST",
        keepalive: true,
        body: JSON.stringify({
          userId: teacher.deviceId,
          teacherName: teacher.name,
          punchMode: "Face AI",
          clientMode: getClientMode(),
          deviceToken: getDeviceToken(),
          isTempUniversal: isTempUniversalActive(),
          timestamp: new Date().toISOString()
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data && data.status === "SUCCESS") {
          const confirmedName = data.name || teacher.name;
          const punchType = String(data.type || "Marked");
          setStatus(
            `<b>${escapeHtml(confirmedName)}</b> — ${escapeHtml(punchType)} at ${escapeHtml(data.time || localTime)}`,
            "success",
            STATUS_RESET_AFTER_MS,
            true
          );
          if (punchType.toLowerCase().includes("out")) {
            speakFirstNameOnly(confirmedName);
          }
        } else if (data && data.message) {
          setStatus(`<b>${escapeHtml(teacher.name)}</b> — ${escapeHtml(data.message)}`, "warn", STATUS_RESET_AFTER_MS, true);
        }
      })
      .catch(() => {})
      .finally(() => {
        isPunchInFlight[teacher.deviceId] = false;
        lastPunchTime[teacher.deviceId] = Date.now();
      });
    }

    function escapeHtml(s) {
      return String(s === null || s === undefined ? "" : s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function escapeAttr(s) {
      return escapeHtml(s).replace(/'/g, "&#39;");
    }

    setInterval(() => {
      updateCountdownClock();
    }, 1000);

    setInterval(() => {
      updateModeLabels();
      updateAdminTempPinDisplay();
    }, 30000);

    setInterval(() => {
      if (isModelLoaded && !isScanBusy && !isSyncing) {
        fetchConfigAndTeachers(false);
      }
    }, AUTO_SYNC_INTERVAL_MS);

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden && isModelLoaded && !isSyncing) {
        updateModeLabels();
        updateCountdownClock();
        fetchConfigAndTeachers(false);
      }
    });

    window.addEventListener("online", () => {
      if (isModelLoaded && !isSyncing) {
        fetchConfigAndTeachers(false);
      }
    });

    fitSlimWindowIfPopup();
    getDeviceToken();
    updateCountdownClock();
    loadModels();
  </script>
</body>
</html>
