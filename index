        if (!d || !d.deviceToken) return;
        const tok = String(d.deviceToken);
        const existing = map[tok] || {};
        map[tok] = {
          token: tok,
          label: d.label || existing.label || "Universal Device",
          requireGps: (typeof d.requireGps === "boolean") ? d.requireGps : (typeof existing.requireGps === "boolean" ? existing.requireGps : true),
          updatedAt: Date.now()
        };
      });
      saveUniversalDevicesMap(map);
      renderUniversalDevicesList();
      updateModeLabels();
