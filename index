    function parseDescriptorsList(rawDescriptor) {
      if (!rawDescriptor) return [];
      try {
        const parsed = typeof rawDescriptor === "string" ? JSON.parse(rawDescriptor) : rawDescriptor;
        if (!Array.isArray(parsed) || parsed.length === 0) return [];

        if (Array.isArray(parsed[0])) {
          const list = [];
          for (let i = 0; i < parsed.length; i++) {
            if (Array.isArray(parsed[i]) && parsed[i].length > 0) {
              list.push(new Float32Array(parsed[i]));
            }
          }
          return list;
        }

        return [new Float32Array(parsed)];
      } catch (e) {
        return [];
      }
    }

    function rebuildPreparedTeachers() {
      const list = [];
      for (const t of registeredTeachers) {
        const descArr = parseDescriptorsList(t.faceDescriptor);
        if (descArr.length > 0) {
