    function updateAngleBadges() {
      const map = [
        { key: "front", id: "badge-front", btnId: "btn-attach-front" },
        { key: "left", id: "badge-left", btnId: "btn-attach-left" },
        { key: "right", id: "badge-right", btnId: "btn-attach-right" }
      ];
      map.forEach(item => {
        const badge = document.getElementById(item.id);
        const btn = document.getElementById(item.btnId);
        const done = Array.isArray(capturedSlots[item.key]) && capturedSlots[item.key].length === 128;
        if (badge) {
          badge.innerText = done ? "✓ Done" : "Attach";
          badge.className = done ? "text-[10px] text-emerald-400 font-bold" : "text-[10px] text-amber-300";
        }
        if (btn) {
          btn.className = done
            ? "bg-emerald-950/60 hover:bg-emerald-900/60 border border-emerald-500 text-emerald-200 py-2.5 px-2 rounded-lg text-[11px] font-semibold text-center"
            : "bg-slate-900 hover:bg-slate-700 border border-slate-600 text-slate-200 py-2.5 px-2 rounded-lg text-[11px] font-semibold text-center";
        }
      });
