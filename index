<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>Brahmadev Public School - Smart Face Attendance Kiosk</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="faceapi-script" src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.13/dist/face-api.js"></script>
  <style>
    body {
      background: #0b1120;
      color: #f8fafc;
      font-family: "Segoe UI", Arial, sans-serif;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 100vh;
    }
    video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.1s ease;
    }
    canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
  </style>
</head>
<body class="p-4 flex flex-col items-center justify-between">

  <!-- Header -->
  <header class="text-center w-full py-2 relative pr-10">
    <h1 class="text-xl font-bold text-sky-400">Brahmadev Public School</h1>
    <p id="device-mode-label" class="text-xs text-slate-400 break-words">Face Attendance Kiosk (30m GPS Active)</p>
    <p id="temp-countdown-clock" class="hidden text-xs font-mono font-bold text-emerald-300 bg-emerald-950/70 border border-emerald-500/50 rounded-full px-3 py-0.5 inline-block mt-1">
      ⏳ 00:00:00
    </p>
    <p id="policy-badge" class="text-[11px] text-amber-300 mt-0.5">Mode: Syncing...</p>
    <button
      onclick="openAdminModal()"
      title="Admin Settings"
      class="absolute top-2 right-0 bg-slate-800 hover:bg-slate-700 p-2 rounded-full border border-slate-700 text-sm"
    >⚙️</button>
  </header>

  <!-- Scanner Area -->
  <main class="flex flex-col items-center justify-center relative w-full max-w-sm flex-grow my-2">
    <div id="loading-box" class="text-sky-300 font-medium text-xs mb-2 animate-pulse text-center">
      AI Face Models Loading...
    </div>

    <div class="relative w-[270px] h-[360px] bg-black rounded-2xl overflow-hidden shadow-2xl border-2 border-sky-500">
      <video id="webcam" autoplay muted playsinline></video>
      <canvas id="overlay"></canvas>

      <!-- Top Lens Guide Inside Frame -->
      <div class="absolute top-2 inset-x-2 z-10 pointer-events-none flex justify-center">
        <span class="bg-slate-950/75 text-sky-200 border border-sky-500/40 px-2.5 py-0.5 rounded-full text-[10px] font-medium">
          Look straight into the camera lens
        </span>
      </div>

      <!-- Bottom Live Name & Status Inside Frame -->
      <div
        id="frame-overlay-status"
        class="hidden absolute bottom-2.5 inset-x-2.5 z-10 pointer-events-none px-3 py-2 rounded-xl bg-slate-950/85 border border-emerald-500/60 text-center text-xs font-bold text-emerald-300 shadow-lg"
      ></div>
    </div>

    <div class="flex items-center gap-2 mt-2.5 flex-wrap justify-center">
      <button
        onclick="switchCamera()"
        class="bg-slate-800 hover:bg-slate-700 text-sky-300 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-semibold"
      >
        Front / Back Camera
      </button>
      <button
        onclick="syncSheetNow()"
        class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-semibold"
      >
        Sync Sheet
      </button>
      <button
        onclick="refreshKiosk()"
        class="bg-sky-900/80 hover:bg-sky-800 text-sky-200 border border-sky-700 px-3 py-1.5 rounded-lg text-xs font-semibold"
      >
        Refresh
      </button>
    </div>

    <!-- Temporary Universal Activation, Request PIN & Slim Pop-up Buttons -->
    <div class="mt-2 flex items-center gap-2 justify-center flex-wrap">
      <button
        id="btn-temp-universal"
        onclick="openTempPinModal()"
        class="bg-emerald-950/80 hover:bg-emerald-900 text-emerald-300 border border-emerald-600/70 px-3.5 py-1.5 rounded-lg text-xs font-semibold"
      >
        🔑 Temp Universal (4-Digit PIN)
      </button>
      <button
        type="button"
        onclick="requestNewTempPinToSheet()"
        class="bg-amber-950/80 hover:bg-amber-900 text-amber-300 border border-amber-600/70 px-3 py-1.5 rounded-lg text-xs font-semibold"
      >
        Request PIN
      </button>
      <button
        id="btn-open-popup"
        type="button"
        onclick="launchSlimPopup()"
        title="Open Slim Pop-up Window"
        class="bg-indigo-950/80 hover:bg-indigo-900 text-indigo-200 border border-indigo-500/70 px-3 py-1.5 rounded-lg text-xs font-semibold"
      >
        🗗 Pop-up
      </button>
    </div>

    <div id="status-card" class="mt-3 px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-center w-full">
      <span id="status-text" class="text-sm font-medium text-amber-400">Camera initializing...</span>
    </div>
  </main>

  <!-- Custom Temp 4-Digit PIN Modal (With Request PIN Button) -->
  <div id="temp-pin-modal" class="hidden fixed inset-0 bg-black/85 flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-emerald-600/70 w-full max-w-xs p-5 rounded-2xl shadow-2xl">
      <div class="flex justify-between items-center mb-2 border-b border-slate-800 pb-2">
        <h3 id="temp-modal-title" class="text-sm font-bold text-emerald-300">Temp Universal (12h 0m • No GPS)</h3>
        <button onclick="closeTempPinModal()" class="text-slate-400 hover:text-white font-bold text-base">✕</button>
      </div>
      <p class="text-xs text-slate-300 mb-3">
        Enter 4-Digit Temporary Universal PIN, or tap <b>Request PIN</b> to generate and save a new PIN in Google Sheet.
      </p>
      <input
        id="temp-pin-input"
        type="tel"
        inputmode="numeric"
        maxlength="4"
        placeholder="4-Digit PIN (e.g. 4829)"
        class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2.5 text-center text-base font-bold tracking-widest text-white mb-3"
      >
      <div class="grid grid-cols-2 gap-2 mb-2">
        <button
          type="button"
          onclick="requestNewTempPinToSheet()"
          class="bg-amber-600 hover:bg-amber-700 text-white py-2 rounded-lg text-xs font-semibold"
        >
          Request PIN
        </button>
        <button
          id="btn-activate-temp-pin"
          type="button"
          onclick="submitTempUniversalPin()"
          class="bg-emerald-600 hover:bg-emerald-700 text-white py-2 rounded-lg text-xs font-semibold"
        >
          Activate (12h)
        </button>
      </div>
      <p id="temp-pin-modal-msg" class="text-[11px] text-center text-amber-300 mt-1.5"></p>
    </div>
  </div>

  <!-- Admin Modal -->
  <div id="admin-modal" class="hidden fixed inset-0 bg-black/85 flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-700 w-full max-w-md p-5 rounded-2xl shadow-2xl overflow-y-auto max-h-[92vh]">
      <div class="flex justify-between items-center mb-3 border-b border-slate-800 pb-2">
        <h2 class="text-lg font-bold text-sky-400">Admin Kiosk Control</h2>
        <button onclick="closeAdminModal()" class="text-slate-400 hover:text-white font-bold text-lg">✕</button>
      </div>

      <!-- Temp Universal Timer (Hours & Minutes + Live Countdown Clock) -->
      <div class="mb-4 bg-indigo-950/40 p-3.5 rounded-xl border border-indigo-500/60">
        <div class="flex items-center justify-between gap-2 mb-1">
          <h3 class="text-sm font-semibold text-indigo-300">Temp Universal Time (Hours / Minutes)</h3>
          <span id="admin-live-countdown" class="text-xs font-mono font-bold text-emerald-300 bg-slate-900 px-2 py-0.5 rounded border border-emerald-500/40">
            --:--:--
          </span>
        </div>
        <p class="text-[11px] text-slate-300 mb-2.5">
          जितने घंटे या मिनट सेट करेंगे, पिन से Universal एक्टिव होने पर उतने समय की उल्टी गिनती (Back Counting) शुरू हो जाएगी।
        </p>
        <div class="grid grid-cols-2 gap-2 mb-2">
          <div>
            <label class="block text-[10px] text-slate-400 mb-1">Hours (घंटे)</label>
            <input
              id="temp-hours-input"
              type="number"
              min="0"
              max="168"
              step="1"
              value="12"
              class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white"
            >
          </div>
          <div>
            <label class="block text-[10px] text-slate-400 mb-1">Minutes (मिनट)</label>
            <input
              id="temp-minutes-input"
              type="number"
              min="0"
              max="59"
              step="1"
              value="0"
              class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white"
            >
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="saveTempUniversalDuration()"
            class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg text-xs font-semibold"
          >
            Save Time
          </button>
          <button
            type="button"
            onclick="stopTempUniversalNow()"
            class="bg-rose-900/80 hover:bg-rose-800 text-rose-200 border border-rose-600/60 px-3 py-2 rounded-lg text-xs font-semibold"
          >
            Stop Now
          </button>
        </div>
        <p id="temp-duration-status" class="text-[11px] text-emerald-300 mt-1.5"></p>
      </div>

      <!-- Current 4-Digit Temporary Universal PIN Viewer (Saved in Google Sheet) -->
      <div class="mb-4 bg-emerald-950/40 p-3.5 rounded-xl border border-emerald-600/60">
        <div class="flex items-center justify-between gap-2 mb-1">
          <h3 class="text-sm font-semibold text-emerald-300">Temp Universal PIN (Sheet Synced)</h3>
          <button
            type="button"
            onclick="requestNewTempPinToSheet()"
            class="bg-amber-600 hover:bg-amber-700 text-white px-2.5 py-1 rounded-lg text-[11px] font-semibold"
          >
            Request PIN
          </button>
        </div>
        <p class="text-[11px] text-slate-300 mb-2">
          Request PIN दबाने पर नया 4-डिजिट पिन शीट में सेव होता है। अपने फ़ोन में <b>Sync Sheet</b> दबाकर यहाँ Admin खोलने पर पिन दिख जाएगा।
        </p>
        <div class="flex items-center justify-between bg-slate-900 border border-emerald-500/40 rounded-lg px-3 py-2">
          <div>
            <span class="text-[10px] text-slate-400 block">Active 4-Digit PIN (From Sheet):</span>
            <span id="admin-current-temp-pin" class="text-2xl font-extrabold tracking-widest text-emerald-400">----</span>
          </div>
          <div class="text-right">
            <span id="admin-temp-pin-expiry" class="text-[10px] text-amber-300 block">Syncing...</span>
            <button
              type="button"
              onclick="syncSheetNow()"
              class="text-[10px] text-sky-400 underline mt-0.5"
            >
              Sync Sheet Now
            </button>
          </div>
        </div>
      </div>

      <!-- Same-Teacher Punch Delay Settings -->
      <div class="mb-4 bg-slate-800 p-3.5 rounded-xl border border-slate-700">
        <div class="flex items-center justify-between gap-2 mb-1">
          <h3 class="text-sm font-semibold text-sky-300">Same-Teacher Punch Delay (Seconds)</h3>
          <label class="flex items-center gap-1.5 text-xs text-slate-200 cursor-pointer select-none">
            <input
              id="punch-delay-enabled"
              type="checkbox"
              checked
              onchange="togglePunchDelayCheckbox(this.checked)"
              class="w-4 h-4 accent-sky-500 rounded"
            >
            <span>Enable Delay</span>
          </label>
        </div>
        <p class="text-xs text-slate-400 mb-2">
          उसी टीचर का अगला पंच इतने सेकंड बाद ही लगेगा (दूसरे टीचर तुरंत लगा सकते हैं)। <b>0</b> या अनटिक करने पर डिले बंद हो जाएगा।
        </p>
        <div class="flex items-center gap-2">
          <input
            id="punch-delay-input"
            type="number"
            min="0"
            max="3600"
            step="1"
            value="3"
            placeholder="Seconds (e.g. 3 or 0)"
            class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white"
          >
          <button
            onclick="savePunchDelaySetting()"
            class="bg-sky-600 hover:bg-sky-700 text-white px-4 py-2 rounded-lg text-xs font-semibold whitespace-nowrap"
          >
            Save Delay
          </button>
        </div>
        <p id="punch-delay-status" class="text-[11px] text-emerald-300 mt-1.5"></p>
      </div>

      <!-- GPS Radius Settings -->
      <div class="mb-4 bg-slate-800 p-3.5 rounded-xl border border-slate-700">
        <h3 class="text-sm font-semibold text-amber-400 mb-1">GPS Radius Setting (Meters)</h3>
        <p class="text-xs text-slate-400 mb-2">
          Set allowed campus boundary radius in meters (default: 30m).
        </p>
        <div class="flex items-center gap-2">
          <input
            id="gps-radius-input"
            type="number"
            min="5"
            max="5000"
            step="1"
            value="30"
            placeholder="Meters (e.g. 30)"
            class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white"
          >
          <button
            onclick="saveGpsRadius()"
            class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-lg text-xs font-semibold whitespace-nowrap"
          >
            Save Meters
          </button>
        </div>
        <p id="gps-radius-status" class="text-[11px] text-emerald-300 mt-1.5"></p>
      </div>

      <!-- Universal Binding & Device GPS Bypass List -->
      <div class="mb-4 bg-slate-800 p-3.5 rounded-xl border border-slate-700">
        <h3 class="text-sm font-semibold text-emerald-400 mb-1">Permanent Universal Kiosk Binding &amp; GPS Control</h3>
        <p class="text-xs text-slate-400 mb-2.5">
          Bind this device permanently as Universal, or toggle <b>GPS</b> per universal device. Unticked = no GPS boundary check for that device.
        </p>
        <input
          id="universal-label-input"
          type="text"
          placeholder="Device Label (e.g. Office / Gate Kiosk)"
          class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white mb-2"
        >
        <input
          id="universal-pin-input"
          type="password"
          value="bps1234"
          placeholder="Universal PIN (bps1234)"
          class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white mb-2"
        >
        <button
          onclick="bindUniversalDevice()"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-2 rounded-lg text-xs font-semibold mb-3"
        >
          Bind as Permanent Universal Device
        </button>

        <div class="border-t border-slate-700 pt-2.5">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-sky-300">Universal Devices List</span>
            <span class="text-[10px] text-slate-400">Tick = GPS Required | Untick = No GPS</span>
          </div>
          <div id="universal-devices-list" class="space-y-2 max-h-44 overflow-y-auto">
            <p class="text-xs text-slate-400">No universal devices bound yet.</p>
          </div>
        </div>
      </div>

      <!-- Face Enrollment by Attaching 3 Photos -->
      <div class="bg-slate-800 p-3.5 rounded-xl border border-slate-700">
        <h3 class="text-sm font-semibold text-sky-400 mb-1">Enroll Teacher Face (Attach 3 Photos)</h3>
        <p class="text-xs text-slate-400 mb-3">
          Tap each button to open your phone's camera or gallery and attach <b>Front</b>, <b>Slight Left</b>, and <b>Slight Right</b> photos.
        </p>

        <label class="block text-xs font-medium text-slate-300 mb-1">Select Teacher:</label>
        <select
          id="enroll-teacher-select"
          onchange="resetCapturedSamples()"
          class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-xs text-white mb-3"
        >
          <option value="">-- Loading teachers --</option>
        </select>

        <input
          id="file-front"
          type="file"
          accept="image/*"
          capture="environment"
          class="hidden"
          onchange="handlePhotoAttach('front', this)"
        >
        <input
          id="file-left"
          type="file"
          accept="image/*"
          capture="environment"
          class="hidden"
          onchange="handlePhotoAttach('left', this)"
        >
        <input
          id="file-right"
          type="file"
          accept="image/*"
          capture="environment"
          class="hidden"
          onchange="handlePhotoAttach('right', this)"
        >

        <div class="grid grid-cols-3 gap-2 mb-3">
          <button
            id="btn-attach-front"
            type="button"
            onclick="triggerPhotoAttach('file-front')"
            class="bg-slate-900 hover:bg-slate-700 border border-slate-600 text-slate-200 py-2.5 px-2 rounded-lg text-[11px] font-semibold text-center"
          >
            1. Front Photo<br><span id="badge-front" class="text-[10px] text-amber-300">Attach</span>
          </button>
          <button
            id="btn-attach-left"
            type="button"
            onclick="triggerPhotoAttach('file-left')"
            class="bg-slate-900 hover:bg-slate-700 border border-slate-600 text-slate-200 py-2.5 px-2 rounded-lg text-[11px] font-semibold text-center"
          >
            2. Left Photo<br><span id="badge-left" class="text-[10px] text-amber-300">Attach</span>
          </button>
          <button
            id="btn-attach-right"
            type="button"
            onclick="triggerPhotoAttach('file-right')"
            class="bg-slate-900 hover:bg-slate-700 border border-slate-600 text-slate-200 py-2.5 px-2 rounded-lg text-[11px] font-semibold text-center"
          >
            3. Right Photo<br><span id="badge-right" class="text-[10px] text-amber-300">Attach</span>
          </button>
        </div>

        <button
          id="btn-save-3-samples"
          type="button"
          onclick="saveAllThreeFaceSamples()"
          class="w-full bg-sky-600 hover:bg-sky-700 text-white py-2.5 rounded-lg text-xs font-semibold"
        >
          Save All 3 Photos (Front + Left + Right)
        </button>
        <p id="enroll-status" class="text-center text-xs font-semibold mt-2 text-amber-300"></p>
      </div>
    </div>
  </div>

  <footer class="w-full text-center pb-1 text-[11px] text-slate-500 border-t border-slate-800 pt-2">
    Brahmadev Public School • Full-Frame Portrait Face Kiosk
  </footer>

  <script>
    const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbxOuB7J6UXRQ5IT66GaM4dHSILcyUSu1JsIAoa7i-_DYeg6SpsiiwqJ7E1a4SpxdLE2/exec";
    const MASTER_ADMIN_PIN = "admin@2007";
    const DEFAULT_CAMPUS_METERS = 30;
    const DEFAULT_DELAY_SECONDS = 3;
    const DEFAULT_TEMP_HOURS = 12;
    const DEFAULT_TEMP_MINUTES = 0;

    const TURBO_DETECTOR_OPTIONS = () => new faceapi.TinyFaceDetectorOptions({
      inputSize: 128,
      scoreThreshold: 0.5
    });
    const MATCH_THRESHOLD = 0.55;
    const STRONG_MATCH_BREAK = 0.45;
    const AUTO_SYNC_INTERVAL_MS = 120000;
    const FRAME_MIN_GAP_MS = 350;
    const STATUS_RESET_AFTER_MS = 3000;

    const video = document.getElementById("webcam");
    const statusText = document.getElementById("status-text");
    const frameOverlayStatus = document.getElementById("frame-overlay-status");
    const loadingBox = document.getElementById("loading-box");
    const statusCard = document.getElementById("status-card");

    const turboCanvas = document.createElement("canvas");
    turboCanvas.width = 240;
    turboCanvas.height = 180;
    const turboCtx = turboCanvas.getContext("2d", { willReadFrequently: true });

    let isModelLoaded = false;
    let registeredTeachers = [];
    let preparedTeachers = [];
    let schoolLat = 26.5804989;
    let schoolLng = 85.5090629;
    let attendanceMode = "Universal_And_Teacher";
    let lastPunchTime = {};
    let isPunchInFlight = {};
    let useFrontCamera = true;
    let currentStream = null;
    let isScanBusy = false;
    let isSyncing = false;
    let scanRafActive = false;
    let lastScanTimestamp = 0;
    let statusResetTimer = null;
    let syncedTempPin = "";
    let syncedTempPinExpires = 0;

    let capturedSlots = {
      front: null,
      left: null,
      right: null
    };

    let cachedCoords = null;
    let cachedCoordsTime = 0;

    function launchSlimPopup() {
      const targetW = 316;
      const targetH = 560;
      const leftPos = Math.max(0, (screen.availWidth || 1024) - targetW - 8);
      const topPos = Math.max(0, (screen.availHeight || 768) - targetH - 8);
      const cleanUrl = window.location.href.split("?")[0] + "?slim=1";
      const pop = window.open(
        cleanUrl,
        "BPSFaceKioskSlim",
        `popup=yes,width=${targetW},height=${targetH},left=${leftPos},top=${topPos},menubar=no,toolbar=no,location=no,status=no,scrollbars=no,resizable=yes`
      );
      if (pop) {
        pop.focus();
      } else {
        alert("Pop-up blocked! ब्राउज़र के एड्रेस बार में Pop-up Allow करें।");
      }
    }

    function fitSlimWindowIfPopup() {
      const params = new URLSearchParams(window.location.search);
      const isSlim = params.get("slim") === "1" || Boolean(window.opener);
      const popBtn = document.getElementById("btn-open-popup");
      if (popBtn && isSlim) {
        popBtn.classList.add("hidden");
      }
      if (isSlim && window.opener && typeof window.resizeTo === "function") {
        try {
          window.resizeTo(316, 560);
        } catch (e) {}
      }
    }

    function getConfiguredTempDurationMs() {
      const rawHrs = parseInt(localStorage.getItem("bps_temp_universal_hours") || String(DEFAULT_TEMP_HOURS), 10);
      const rawMins = parseInt(localStorage.getItem("bps_temp_universal_minutes") || String(DEFAULT_TEMP_MINUTES), 10);
      const hrs = isNaN(rawHrs) || rawHrs < 0 ? DEFAULT_TEMP_HOURS : rawHrs;
      const mins = isNaN(rawMins) || rawMins < 0 ? DEFAULT_TEMP_MINUTES : rawMins;
      const totalMs = (hrs * 60 + mins) * 60 * 1000;
      return totalMs > 0 ? totalMs : (DEFAULT_TEMP_HOURS * 60 * 60 * 1000);
    }

    function formatDurationShort() {
      const ms = getConfiguredTempDurationMs();
      const totalMins = Math.round(ms / 60000);
      const hrs = Math.floor(totalMins / 60);
      const mins = totalMins % 60;
      if (hrs > 0 && mins > 0) return `${hrs}h ${mins}m`;
      if (hrs > 0) return `${hrs}h`;
      return `${mins}m`;
    }

    function loadTempDurationUI() {
      const rawHrs = parseInt(localStorage.getItem("bps_temp_universal_hours") || String(DEFAULT_TEMP_HOURS), 10);
      const rawMins = parseInt(localStorage.getItem("bps_temp_universal_minutes") || String(DEFAULT_TEMP_MINUTES), 10);
      const hrsInp = document.getElementById("temp-hours-input");
      const minsInp = document.getElementById("temp-minutes-input");
      if (hrsInp && document.activeElement !== hrsInp) {
        hrsInp.value = isNaN(rawHrs) ? DEFAULT_TEMP_HOURS : rawHrs;
      }
      if (minsInp && document.activeElement !== minsInp) {
        minsInp.value = isNaN(rawMins) ? DEFAULT_TEMP_MINUTES : rawMins;
      }
    }

    function saveTempUniversalDuration() {
      const hrsInp = document.getElementById("temp-hours-input");
      const minsInp = document.getElementById("temp-minutes-input");
      const statusEl = document.getElementById("temp-duration-status");
      const hrs = parseInt(hrsInp ? hrsInp.value : "0", 10);
      const mins = parseInt(minsInp ? minsInp.value : "0", 10);

      if (isNaN(hrs) || hrs < 0 || hrs > 168 || isNaN(mins) || mins < 0 || mins > 59) {
        if (statusEl) {
          statusEl.className = "text-[11px] text-red-400 mt-1.5";
          statusEl.innerText = "कृपया घंटे (0–168) और मिनट (0–59) सही डालें।";
        }
        return;
      }
      if (hrs === 0 && mins === 0) {
        if (statusEl) {
          statusEl.className = "text-[11px] text-red-400 mt-1.5";
          statusEl.innerText = "कम से कम 1 मिनट या घंटा सेट करें।";
        }
        return;
      }

      localStorage.setItem("bps_temp_universal_hours", String(hrs));
      localStorage.setItem("bps_temp_universal_minutes", String(mins));

      // If Temp Universal is currently active, update its expiry to the newly configured countdown
      if (isTempUniversalActive()) {
        const newExpiry = Date.now() + ((hrs * 60 + mins) * 60 * 1000);
        localStorage.setItem("bps_temp_universal_until", String(newExpiry));
      }

      updateModeLabels();
      updateCountdownClock();
      if (statusEl) {
        statusEl.className = "text-[11px] text-emerald-300 mt-1.5";
        statusEl.innerText = `Temp Universal अवधि ${hrs} घंटे ${mins} मिनट पर सेव हो गई!`;
      }
    }

    function stopTempUniversalNow() {
      localStorage.removeItem("bps_temp_universal_until");
      updateModeLabels();
      updateCountdownClock();
      const statusEl = document.getElementById("temp-duration-status");
      if (statusEl) {
        statusEl.className = "text-[11px] text-amber-300 mt-1.5";
        statusEl.innerText = "Temp Universal तुरंत बंद कर दिया गया है।";
      }
    }

    function formatCountdownHMS(ms) {
      if (ms <= 0) return "00:00:00";
      const totalSec = Math.floor(ms / 1000);
      const hrs = Math.floor(totalSec / 3600);
      const mins = Math.floor((totalSec % 3600) / 60);
      const secs = totalSec % 60;
      const pad = n => String(n).padStart(2, "0");
      return `${pad(hrs)}:${pad(mins)}:${pad(secs)}`;
    }

    function updateCountdownClock() {
      const expiry = getTempUniversalExpiry();
      const headerClock = document.getElementById("temp-countdown-clock");
      const adminClock = document.getElementById("admin-live-countdown");

      if (expiry > Date.now()) {
        const remMs = expiry - Date.now();
        const hms = formatCountdownHMS(remMs);
        if (headerClock) {
          headerClock.classList.remove("hidden");
          headerClock.innerText = `⏳ Temp Universal Left: ${hms}`;
        }
        if (adminClock) {
          adminClock.innerText = `⏳ ${hms}`;
          adminClock.className = "text-xs font-mono font-bold text-emerald-300 bg-slate-900 px-2 py-0.5 rounded border border-emerald-500/40";
        }
      } else {
        if (headerClock) {
          headerClock.classList.add("hidden");
          headerClock.innerText = "⏳ 00:00:00";
        }
        if (adminClock) {
          adminClock.innerText = `Inactive (${formatDurationShort()})`;
          adminClock.className = "text-xs font-mono font-semibold text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-700";
        }
        updateModeLabels();
      }
    }

    function getTempUniversalExpiry() {
      const raw = parseInt(localStorage.getItem("bps_temp_universal_until") || "0", 10);
      if (isNaN(raw) || raw <= Date.now()) {
        if (raw > 0) {
          localStorage.removeItem("bps_temp_universal_until");
        }
        return 0;
      }
      return raw;
    }

    function isTempUniversalActive() {
      return getTempUniversalExpiry() > Date.now();
    }

    function formatRemainingTime(ms) {
      if (ms <= 0) return "0m";
      const totalMins = Math.ceil(ms / 60000);
      const hrs = Math.floor(totalMins / 60);
      const mins = totalMins % 60;
      if (hrs > 0) return `${hrs}h ${mins}m`;
      return `${mins}m`;
    }

    function updateAdminTempPinDisplay() {
      const pinEl = document.getElementById("admin-current-temp-pin");
      const expEl = document.getElementById("admin-temp-pin-expiry");
      if (pinEl) {
        pinEl.innerText = syncedTempPin || "----";
      }
      if (expEl) {
        if (syncedTempPin && syncedTempPinExpires > Date.now()) {
          expEl.innerText = `From Sheet • ${formatRemainingTime(syncedTempPinExpires - Date.now())} left`;
        } else if (syncedTempPin) {
          expEl.innerText = "From Sheet (Single-Use)";
        } else {
          expEl.innerText = "Tap Sync Sheet or Request PIN";
        }
      }
    }

    function openTempPinModal() {
      const modal = document.getElementById("temp-pin-modal");
      const inp = document.getElementById("temp-pin-input");
      const msg = document.getElementById("temp-pin-modal-msg");
      const titleEl = document.getElementById("temp-modal-title");
      const actBtn = document.getElementById("btn-activate-temp-pin");
      const durLabel = formatDurationShort();

      if (titleEl) titleEl.innerText = `Temp Universal (${durLabel} • No GPS)`;
      if (actBtn) actBtn.innerText = `Activate (${durLabel})`;
