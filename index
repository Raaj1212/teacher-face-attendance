    }

    function getPunchDelayMs() {
      const enabledRaw = localStorage.getItem("bps_punch_delay_enabled");
      const enabled = enabledRaw === null ? true : enabledRaw === "true";
      if (!enabled) return 0;

      const secRaw = localStorage.getItem("bps_punch_delay_seconds");
      const sec = secRaw === null ? DEFAULT_DELAY_SECONDS : parseFloat(secRaw);
      if (isNaN(sec) || sec <= 0) return 0;
      return Math.round(sec * 1000);
    }

    function loadPunchDelayUI() {
      const enabledRaw = localStorage.getItem("bps_punch_delay_enabled");
      const enabled = enabledRaw === null ? true : enabledRaw === "true";
      const secRaw = localStorage.getItem("bps_punch_delay_seconds");
      const sec = secRaw === null ? DEFAULT_DELAY_SECONDS : parseFloat(secRaw);

      const cb = document.getElementById("punch-delay-enabled");
      const inp = document.getElementById("punch-delay-input");
      if (cb) cb.checked = enabled && !(sec === 0);
