    function triggerPhotoAttach(inputId) {
      const teacherId = document.getElementById("enroll-teacher-select").value;
      if (!teacherId) {
        setEnrollStatusText("Please select a teacher first.", "error");
        return;
      }
      if (!isModelLoaded || typeof faceapi === "undefined") {
        setEnrollStatusText("Wait for AI models to finish loading...", "neutral");
        return;
      }
      const inp = document.getElementById(inputId);
      if (inp) {
        inp.value = "";
        inp.click();
      }
    }

    function loadFileAsImage(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = e => {
          const img = new Image();
          img.onload = () => resolve(img);
          img.onerror = () => reject(new Error("Could not decode image file"));
          img.src = e.target.result;
        };
        reader.onerror = () => reject(new Error("Could not read selected file"));
        reader.readAsDataURL(file);
      });
    }

    async function handlePhotoAttach(angleKey, inputEl) {
      const file = inputEl && inputEl.files && inputEl.files[0];
      if (!file) return;

      const labelMap = {
        front: "Front Photo",
        left: "Left Photo",
        right: "Right Photo"
      };
      const photoLabel = labelMap[angleKey] || angleKey;

      capturedSlots[angleKey] = null;
      updateAngleBadges();
      setEnrollStatusText(`Reading face from ${photoLabel}...`, "neutral");

      try {
        const img = await loadFileAsImage(file);
        const detection = await faceapi
          .detectSingleFace(img, new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.4 }))
          .withFaceLandmarks()
          .withFaceDescriptor();

        if (!detection || !detection.descriptor || detection.descriptor.length !== 128) {
          setEnrollStatusText(`${photoLabel}: no clear face found — attach another clear photo.`, "error");
          return;
        }

        capturedSlots[angleKey] = Array.from(detection.descriptor);
        updateAngleBadges();
        setEnrollStatusText(`${photoLabel} processed successfully!`, "success");
      } catch (err) {
        setEnrollStatusText(`${photoLabel} error: ` + err.message, "error");
      }
    }

    function startBackgroundGpsWatcher() {
      if (!navigator.geolocation) return;
      navigator.geolocation.watchPosition(
        pos => {
          if (pos && pos.coords && (typeof pos.coords.accuracy !== "number" || pos.coords.accuracy <= 150)) {
            cachedCoords = pos.coords;
            cachedCoordsTime = Date.now();
          }
        },
        () => {},
        { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 }
      );
    }

